{
  "expo": {
    "name": "Yococino",
    "slug": "yococino",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yococino",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBFAF6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.yococino",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "app.yococino",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4ECDE"
      },
      "permissions": [
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 240,
          "backgroundColor": "#F4ECDE"
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain"
            ]
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
